DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Set to false only for a local Postgres without TLS.
DATABASE_SSL=true
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SITE_URL=http://localhost:3000
# New accounts use Gmail and confirm it from an emailed link. Mail is sent
# through a Gmail account with an app password (not its normal password):
# turn on 2-Step Verification, then create one at
# https://myaccount.google.com/apppasswords
# Left empty, development prints emails in the console; production refuses
# new sign-ups.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=Libra
